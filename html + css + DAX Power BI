}

/* ==========================================
   OVERLAY HOVER
========================================== */
.kpi-overlay{
    position:absolute;
    left:18px;
    right:18px;
    top:72px;
    bottom:18px;
    border-radius:12px;
    background:rgba(0,163,200,0.95);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:12px;
    box-sizing:border-box;
    opacity:0;
    z-index:5;
    transition:opacity .35s ease;
}

/* Mostrar overlay sobre el KPI */
.kpi-card:hover .kpi-overlay{
