kpiTn = 
VAR tn =  [Toneladas]
VAR tnLy  = CALCULATE( [Toneladas] , SAMEPERIODLASTYEAR(Dim_Calendario[Date]))
VAR Variaciontn =  DIVIDE( tn - tnLy , tnLy )
var tn_formato = 
    SWITCH(
        TRUE(),
        ABS(tn) >= 1e9, FORMAT(tn, "#,,,.00 Bi", "en-US"),
        ABS(tn) >= 1e6, FORMAT(tn, "#,,.00 Mi", "en-US"),
        ABS(tn) >= 1e3, FORMAT(tn, "#,.00 K", "en-US"),
        FORMAT(tn, "#", "en-US")
    )

VAR _VariacionTexto =
FORMAT(
    Variaciontn,
    "+0.0% ⇑;-0.0% ⇓",
    "en-US"
)


VAR _ColorVariacion =
 IF(
    Variaciontn > 0,
    "#18A957",
    "#E53935"
)

RETURN
"
<div class='kpi-card'>

    <!-- CABECERA -->
    <div class='kpi-header'>
        <div class='icon-circle'>🚢</div>
        <div class='kpi-title'>Toneladas</div>
    </div>

    <!-- CUERPO DEL KPI -->
    <div class='kpi-body'>
        <div class='kpi-value'>" & tn_formato & "</div>
        <div class='kpi-variation' style='color:" & _ColorVariacion & ";'>
            " & _VariacionTexto & "
        </div>
    </div>

    <!-- OVERLAY HOVER -->
    <div class='kpi-overlay'>
        <div class='kpi-description'>
            Este KPI muestra las toneladas acumuladas en el período seleccionado
            y su variación respecto al período anterior.
        </div>
    </div>

</div>

<style>
/* ==========================================
   TARJETA PRINCIPAL
========================================== */
.kpi-card{
    position:relative;
    width:100%;
    height:140px;
    border-radius:18px;
    background:linear-gradient(135deg,#f7fbfd 0%,#eef7fa 100%);
    box-shadow:0 6px 18px rgba(0,0,0,0.08);
    overflow:hidden;
    cursor:pointer;
    transition:all .35s ease;
    box-sizing:border-box;
    padding:18px;
    font-family:'Segoe UI', Arial, sans-serif;
}

.kpi-card:hover{
    transform:translateY(-4px);
    box-shadow:0 12px 28px rgba(0,0,0,0.14);
}

/* ==========================================
   CABECERA
========================================== */
.kpi-header{
    display:flex;
    align-items:center;
    gap:12px;
    height:42px;
    margin-bottom:12px;
    position:relative;
    z-index:2;
}

.icon-circle{
    width:42px;
    height:42px;
    border-radius:50%;
    background:linear-gradient(135deg,#00b7d9 0%,#0098c1 100%);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
    color:white;
    box-shadow:0 4px 10px rgba(0,167,207,0.25);
    flex-shrink:0;
}

.kpi-title{
    font-size:14px;
    font-weight:600;
    color:#7a8a99;
}

/* ==========================================
   ÁREA DEL KPI
========================================== */
.kpi-body{
    position:absolute;
    left:18px;
    right:18px;
    top:72px;
    bottom:18px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:flex-start;
    z-index:2;
    transition:opacity .35s ease;
}

/* Ocultar valores al hacer hover */
.kpi-card:hover .kpi-body{
    opacity:0;
}

/* ==========================================
   VALOR PRINCIPAL
========================================== */
.kpi-value{
    font-size:32px;
